{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.agentops.dev/evidence-query/evidence-query-response-0.1.0.schema.json",
  "title": "Evidence Query response 0.1.0",
  "oneOf": [
    { "$ref": "#/definitions/facts_response" },
    { "$ref": "#/definitions/traces_response" },
    { "$ref": "#/definitions/error_response" }
  ],
  "definitions": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$" },
    "hex32": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "hex16": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scalar": { "anyOf": [{ "type": "string" }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] },
    "contract": { "type": "object", "additionalProperties": false, "required": ["name", "revision"], "properties": { "name": { "const": "evidence.query" }, "revision": { "const": "0.1.0" } } },
    "source": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "event_id"], "properties": { "kind": { "const": "EVENT" }, "event_id": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "trace_id", "span_id"], "properties": { "kind": { "const": "SPAN" }, "trace_id": { "$ref": "#/definitions/hex32" }, "span_id": { "$ref": "#/definitions/hex16" } } }
      ]
    },
    "truth": { "type": "object", "additionalProperties": false, "required": ["completeness", "availability", "expiry", "expires_at"], "properties": { "completeness": { "enum": ["FINAL", "LOWER_BOUND", "NOT_APPLICABLE", "UNAVAILABLE", null] }, "availability": { "enum": ["AVAILABLE", "UNAVAILABLE"] }, "expiry": { "enum": ["ACTIVE", "EXPIRED"] }, "expires_at": { "anyOf": [{ "$ref": "#/definitions/timestamp" }, { "type": "null" }] } } },
    "field": { "type": "object", "additionalProperties": false, "required": ["field", "value"], "properties": { "field": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/definitions/scalar" } } },
    "endpoint": { "type": "object", "additionalProperties": false, "required": ["kind", "key"], "properties": { "kind": { "enum": ["FINDING", "FINDING_TARGET", "FIX", "RECHECK", "ROLE", "ROLE_LINEAGE", "SPAN", "DELIVERY", "MODEL_ROLE"] }, "key": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/scalar" } } } },
    "relationship": { "type": "object", "additionalProperties": false, "required": ["kind", "from", "to"], "properties": { "kind": { "enum": ["FINDING_TARGET", "FINDING_FIX", "FINDING_RECHECK", "ROLE_LINEAGE", "DELIVERY_ROOT", "MODEL_ATTRIBUTION"] }, "from": { "$ref": "#/definitions/endpoint" }, "to": { "$ref": "#/definitions/endpoint" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["accepted_digest", "profile_version", "family_schema", "owner_key"], "properties": { "accepted_digest": { "$ref": "#/definitions/sha256" }, "profile_version": { "const": "1.0.0" }, "family_schema": { "type": ["string", "null"] }, "owner_key": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/scalar" } } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["family_schema", "event_name", "completeness", "dimensions"], "properties": { "family_schema": { "type": ["string", "null"] }, "event_name": { "type": ["string", "null"] }, "completeness": { "enum": ["FINAL", "LOWER_BOUND", "NOT_APPLICABLE", "UNAVAILABLE", null] }, "dimensions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/field" } } } },
    "fact": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "recorded_at", "provenance", "compatibility", "truth", "fields", "relationships"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["EVENT_CONTRIBUTION", "FINDING_ASSERTION", "FINDING_TARGET", "FINDING_STATUS", "FINDING_FIX", "FINDING_RECHECK", "ROLE_LINEAGE", "DELIVERY_ROOT_BINDING", "MODEL_ATTRIBUTION"] }, "source": { "$ref": "#/definitions/source" }, "recorded_at": { "$ref": "#/definitions/timestamp" }, "provenance": { "$ref": "#/definitions/provenance" }, "compatibility": { "$ref": "#/definitions/compatibility" }, "truth": { "$ref": "#/definitions/truth" }, "fields": { "type": "array", "maxItems": 73, "items": { "$ref": "#/definitions/field" } }, "relationships": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/relationship" } } } },
    "trace_endpoint": { "type": "object", "additionalProperties": false, "required": ["trace_id", "span_id"], "properties": { "trace_id": { "$ref": "#/definitions/hex32" }, "span_id": { "$ref": "#/definitions/hex16" } } },
    "node": { "type": "object", "additionalProperties": false, "required": ["span_id", "span_name", "span_kind", "start_time_unix_nano", "end_time_unix_nano", "span_status", "span_flags", "trace_state", "fields"], "properties": { "span_id": { "$ref": "#/definitions/hex16" }, "span_name": { "type": "string", "minLength": 1, "maxLength": 128 }, "span_kind": { "enum": ["INTERNAL", "CLIENT"] }, "start_time_unix_nano": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" }, "end_time_unix_nano": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" }, "span_status": { "enum": ["UNSET", "OK", "ERROR"] }, "span_flags": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "trace_state": { "type": ["string", "null"], "maxLength": 512 }, "fields": { "type": "array", "maxItems": 73, "items": { "$ref": "#/definitions/field" } } } },
    "parent_edge": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/definitions/trace_endpoint" }, "to": { "$ref": "#/definitions/trace_endpoint" } } },
    "link_edge": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/definitions/trace_endpoint" }, "to": { "$ref": "#/definitions/trace_endpoint" }, "trace_state": { "type": "string", "maxLength": 512 }, "flags": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } },
    "trace_item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trace_id", "kind", "source", "recorded_at", "truth", "node", "edge"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "trace_id": { "$ref": "#/definitions/hex32" }, "kind": { "enum": ["NODE", "PARENT_EDGE", "LINK"] }, "source": { "$ref": "#/definitions/source" }, "recorded_at": { "$ref": "#/definitions/timestamp" }, "truth": { "$ref": "#/definitions/truth" }, "node": { "anyOf": [{ "$ref": "#/definitions/node" }, { "type": "null" }] }, "edge": { "anyOf": [{ "$ref": "#/definitions/parent_edge" }, { "$ref": "#/definitions/link_edge" }, { "type": "null" }] } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "NODE" } } }, "then": { "properties": { "node": { "$ref": "#/definitions/node" }, "edge": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "PARENT_EDGE" } } }, "then": { "properties": { "node": { "type": "null" }, "edge": { "$ref": "#/definitions/parent_edge" } } } },
        { "if": { "properties": { "kind": { "const": "LINK" } } }, "then": { "properties": { "node": { "type": "null" }, "edge": { "$ref": "#/definitions/link_edge" } } } }
      ]
    },
    "trace_summary": { "type": "object", "additionalProperties": false, "required": ["trace_id", "state"], "properties": { "trace_id": { "$ref": "#/definitions/hex32" }, "state": { "enum": ["AVAILABLE", "PARTIAL", "EXPIRED"] } } },
    "common": { "type": "object", "required": ["contract", "observation_profile", "read_model_revision", "snapshot", "items", "next_cursor"], "properties": { "contract": { "$ref": "#/definitions/contract" }, "observation_profile": { "const": "1.0.0" }, "read_model_revision": { "const": "1.0.0" }, "snapshot": { "type": "string", "minLength": 1 }, "items": { "type": "array" }, "next_cursor": { "type": ["string", "null"] } } },
    "facts_response": { "allOf": [{ "$ref": "#/definitions/common" }, { "type": "object", "additionalProperties": false, "required": ["contract", "observation_profile", "read_model_revision", "snapshot", "items", "next_cursor"], "properties": { "contract": { "$ref": "#/definitions/contract" }, "observation_profile": { "const": "1.0.0" }, "read_model_revision": { "const": "1.0.0" }, "snapshot": { "type": "string", "minLength": 1 }, "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/fact" } }, "next_cursor": { "type": ["string", "null"] } } }] },
    "traces_response": { "allOf": [{ "$ref": "#/definitions/common" }, { "type": "object", "additionalProperties": false, "required": ["contract", "observation_profile", "read_model_revision", "snapshot", "items", "next_cursor", "trace_state", "trace_summaries"], "properties": { "contract": { "$ref": "#/definitions/contract" }, "observation_profile": { "const": "1.0.0" }, "read_model_revision": { "const": "1.0.0" }, "snapshot": { "type": "string", "minLength": 1 }, "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/trace_item" } }, "next_cursor": { "type": ["string", "null"] }, "trace_state": { "enum": ["ABSENT", "AVAILABLE", "PARTIAL", "EXPIRED"] }, "trace_summaries": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/trace_summary" } } } }] },
    "error_response": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "enum": ["INVALID_FILTER", "INVALID_CURSOR", "NOT_ACCEPTABLE", "CURSOR_MISMATCH", "CURSOR_EXPIRED", "QUERY_BOUND_EXCEEDED", "METHOD_NOT_ALLOWED", "ROUTE_NOT_FOUND", "QUERY_INTERNAL", "QUERY_UNAVAILABLE"] }, "message": { "type": "string", "minLength": 1 } } } } }
  }
}
