{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.agentops.dev/evidence-query/fixture-case-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "case_id", "category", "kind", "input", "expected"],
  "properties": {
    "fixture_version": { "const": "0.1.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "category": { "enum": ["positive", "negative", "recovery"] },
    "kind": { "enum": ["response", "internal", "request", "trace_identity", "batch_digest", "batch_selection", "manifest_binding", "same_snapshot"] },
    "input": { "type": "object" },
    "expected": { "enum": ["ACCEPT", "REJECT", "DUPLICATE", "CONFLICT", "RECOVER"] }
  }
}
