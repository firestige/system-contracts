{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.agentops.dev/evidence-query/evidence-query-internal-1.0.0.schema.json",
  "title": "Evidence Query read-model and expiry port values 1.0.0",
  "oneOf": [
    { "$ref": "#/definitions/snapshot_page" },
    { "$ref": "#/definitions/trace_summary_set" },
    { "$ref": "#/definitions/expiry_owner" },
    { "$ref": "#/definitions/expiry_record" },
    { "$ref": "#/definitions/expiry_batch" },
    { "$ref": "#/definitions/expiry_result" }
  ],
  "definitions": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$" },
    "hex32": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "hex16": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scalar": { "anyOf": [{ "type": "string" }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] },
    "owner_key": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/scalar" } },
    "source": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "event_id"], "properties": { "kind": { "const": "EVENT" }, "event_id": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "trace_id", "span_id"], "properties": { "kind": { "const": "SPAN" }, "trace_id": { "$ref": "#/definitions/hex32" }, "span_id": { "$ref": "#/definitions/hex16" } } }
    ] },
    "expiry_owner": { "type": "object", "additionalProperties": false, "required": ["value_type", "resource_kind", "owner_key"], "properties": { "value_type": { "const": "ExpiryOwner" }, "resource_kind": { "enum": ["RAW_DEBUG", "NODE", "PARENT_EDGE", "LINK", "EVENT_CONTRIBUTION", "FINDING_ASSERTION", "FINDING_TARGET", "FINDING_STATUS", "FINDING_FIX", "FINDING_RECHECK", "ROLE_LINEAGE", "DELIVERY_ROOT_BINDING", "MODEL_ATTRIBUTION"] }, "owner_key": { "$ref": "#/definitions/owner_key" } } },
    "compatibility_pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "type": "string" }, { "$ref": "#/definitions/scalar" }] },
    "expiry_record": { "type": "object", "additionalProperties": false, "required": ["value_type", "resource_class", "owner_key", "source", "resource_kind", "recorded_at", "compatibility", "policy_revision", "expires_at", "expired_at"], "properties": { "value_type": { "const": "ExpiryRecord" }, "resource_class": { "enum": ["RAW_DEBUG", "TRACE_DETAIL", "FACTUAL_PROJECTION"] }, "owner_key": { "$ref": "#/definitions/owner_key" }, "source": { "$ref": "#/definitions/source" }, "resource_kind": { "enum": ["RAW_DEBUG", "NODE", "PARENT_EDGE", "LINK", "EVENT_CONTRIBUTION", "FINDING_ASSERTION", "FINDING_TARGET", "FINDING_STATUS", "FINDING_FIX", "FINDING_RECHECK", "ROLE_LINEAGE", "DELIVERY_ROOT_BINDING", "MODEL_ATTRIBUTION"] }, "recorded_at": { "$ref": "#/definitions/timestamp" }, "compatibility": { "type": "array", "maxItems": 7, "items": { "$ref": "#/definitions/compatibility_pair" } }, "policy_revision": { "const": "1.0.0" }, "expires_at": { "$ref": "#/definitions/timestamp" }, "expired_at": { "$ref": "#/definitions/timestamp" } } },
    "expiry_member": { "type": "object", "additionalProperties": false, "required": ["resource_kind", "owner_key"], "properties": { "resource_kind": { "enum": ["RAW_DEBUG", "NODE", "PARENT_EDGE", "LINK", "EVENT_CONTRIBUTION", "FINDING_ASSERTION", "FINDING_TARGET", "FINDING_STATUS", "FINDING_FIX", "FINDING_RECHECK", "ROLE_LINEAGE", "DELIVERY_ROOT_BINDING", "MODEL_ATTRIBUTION"] }, "owner_key": { "$ref": "#/definitions/owner_key" } } },
    "expiry_batch": { "type": "object", "additionalProperties": false, "required": ["value_type", "batch_identity", "resource_class", "policy_revision", "cutoff", "ttl_seconds", "members"], "properties": { "value_type": { "const": "ExpiryBatch" }, "batch_identity": { "$ref": "#/definitions/sha256" }, "resource_class": { "enum": ["RAW_DEBUG", "TRACE_DETAIL", "FACTUAL_PROJECTION"] }, "policy_revision": { "const": "1.0.0" }, "cutoff": { "$ref": "#/definitions/timestamp" }, "ttl_seconds": { "type": "integer", "minimum": 0 }, "members": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/definitions/expiry_member" } } } },
    "expiry_result": { "type": "object", "additionalProperties": false, "required": ["value_type", "batch_identity", "selected", "expired", "already_expired"], "properties": { "value_type": { "const": "ExpiryResult" }, "batch_identity": { "$ref": "#/definitions/sha256" }, "selected": { "type": "integer", "minimum": 0 }, "expired": { "type": "integer", "minimum": 0 }, "already_expired": { "type": "integer", "minimum": 0 } } },
    "trace_summary": { "type": "object", "additionalProperties": false, "required": ["trace_id", "state"], "properties": { "trace_id": { "$ref": "#/definitions/hex32" }, "state": { "enum": ["AVAILABLE", "PARTIAL", "EXPIRED"] } } },
    "trace_summary_set": { "type": "object", "additionalProperties": false, "required": ["value_type", "snapshot_id", "summaries"], "properties": { "value_type": { "const": "TraceSummarySet" }, "snapshot_id": { "type": "string", "minLength": 1 }, "summaries": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/trace_summary" } } } },
    "snapshot_page": { "type": "object", "additionalProperties": false, "required": ["value_type", "contract_revision", "read_model_revision", "snapshot_id", "resources", "next_cursor"], "properties": { "value_type": { "const": "SnapshotPage" }, "contract_revision": { "const": "0.1.0" }, "read_model_revision": { "const": "1.0.0" }, "snapshot_id": { "type": "string", "minLength": 1 }, "resources": { "type": "array", "maxItems": 200, "items": { "oneOf": [{ "$ref": "evidence-query-response-0.1.0.schema.json#/definitions/fact" }, { "$ref": "evidence-query-response-0.1.0.schema.json#/definitions/trace_item" }] } }, "next_cursor": { "type": ["string", "null"] } } }
  }
}
