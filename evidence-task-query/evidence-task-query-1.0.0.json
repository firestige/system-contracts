{
  "coordinate": "evidence.query@1.0.0",
  "status": "REVIEW_CANDIDATE",
  "supersedes_exact": "evidence.query@0.1.0",
  "read_model_revision": "2.0.0",
  "observation_profile": "2.0.0",
  "route": {
    "method": "GET",
    "path": "/v1/evidence/tasks",
    "body": "PROHIBITED",
    "accept": "application/json",
    "unknown_or_repeated_parameter": "INVALID_FILTER",
    "modes": {
      "LIST_TASKS": {
        "required": [],
        "prohibited": ["task_id", "as_of"]
      },
      "TASK_MEMBERSHIP": {
        "required": ["task_id", "as_of"]
      }
    },
    "limit": {
      "default": 100,
      "minimum": 1,
      "maximum": 200
    },
    "pagination": ["limit", "cursor"],
    "task_id": {
      "minimum_characters": 1,
      "maximum_characters": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    }
  },
  "manifest_route": {
    "method": "GET",
    "path": "/v1/evidence/manifests",
    "body": "PROHIBITED",
    "accept": "application/json",
    "required_parameters": ["manifest_digest"],
    "manifest_digest": {
      "exact_characters": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "unknown_or_repeated_parameter": "INVALID_FILTER",
    "pagination": "PROHIBITED",
    "fuzzy_or_latest_lookup": "PROHIBITED",
    "errors": {
      "missing": "NOT_FOUND",
      "conflicting_stored_content": "INTEGRITY_ERROR"
    }
  },
  "projection": {
    "source": "accepted task.binding owner record",
    "transaction": [
      "TASK_DECLARATION",
      "DELIVERY_TASK_MEMBERSHIP",
      "DELIVERY_TASK_GUARD",
      "TASK_DISPLAY_NAME_IF_PRESENT",
      "DELIVERY_MANIFEST"
    ],
    "TASK_DECLARATION": {
      "key": ["task_id"],
      "payload": {}
    },
    "DELIVERY_TASK_MEMBERSHIP": {
      "key": ["task_id", "delivery_id"],
      "payload": ["manifest_digest"]
    },
    "DELIVERY_TASK_GUARD": {
      "key": ["delivery_id"],
      "payload": ["task_id", "manifest_digest"],
      "mismatch": "CONFLICT"
    },
    "TASK_DISPLAY_NAME_IF_PRESENT": {
      "key": ["task_id"],
      "payload": ["display_name"],
      "absent": "NO_EFFECT",
      "different_nonempty_value": "CONFLICT"
    },
    "DELIVERY_MANIFEST": {
      "key": ["manifest_digest"],
      "payload": ["canonical_projection", "projection_digest"],
      "source_equalities": ["delivery_id", "task_id", "manifest_digest"],
      "different_canonical_content": "CONFLICT"
    }
  },
  "response": {
    "LIST_TASKS": ["task_id", "display_name", "provenance"],
    "TASK_MEMBERSHIP": [
      "task_id",
      "delivery_id",
      "manifest_digest",
      "recorded_at",
      "observation_state",
      "integrity_reasons",
      "provenance"
    ],
    "DELIVERY_MANIFEST": ["manifest_digest", "manifest_projection_digest", "projection", "provenance"],
    "display_name_required": false,
    "display_fallback": "task_id",
    "provenance": {
      "fields": ["accepted_digest", "profile_version", "source"],
      "LIST_TASKS": "accepted task.binding that proves the returned display_name; declaration source when display_name is absent",
      "TASK_MEMBERSHIP": "accepted task.binding that created the exact task_id and delivery_id membership",
      "DELIVERY_MANIFEST": "accepted task.binding that created the exact immutable Manifest projection"
    }
  },
  "snapshot": {
    "isolation": "REPEATABLE_READ",
    "scope": "ONE_TASK_ROUTE_TRAVERSAL",
    "cursor_binding": ["mode", "filters", "limit", "snapshot_id"],
    "shared_with_facts_or_traces": false,
    "later_commits_visible": false,
    "manifest_route_independent": true
  },
  "membership_cutoff": {
    "coordinate": "as_of",
    "format": "NORMALIZED_UTC_RFC3339",
    "predicate": "projection.recorded_at <= as_of",
    "arrival_order_implies_causality": false
  },
  "order": {
    "LIST_TASKS": "task_id_BYTEWISE_ASC",
    "TASK_MEMBERSHIP": "delivery_id_BYTEWISE_ASC"
  },
  "delivery_observation": {
    "retention_unit": "DELIVERY",
    "states": ["ACTIVE", "PARTIAL", "EXPIRED"],
    "expiry_effect": "REMOVE_DELIVERY_FROM_ALL_CURRENT_METRIC_INPUTS",
    "expiry_creates_partial": false,
    "all_expired_result": "NO_POPULATION",
    "partial_requires": "RECORDED_ACTIVE_DELIVERY_INTEGRITY_GAP",
    "metric_evaluation_units_unchanged": true,
    "unreferenced_missing_leaf_inference": "PROHIBITED"
  },
  "delivery_integrity_marker": {
    "key": ["delivery_id", "record_identity"],
    "payload": ["record_category", "reason_code", "source_identity", "provenance_digest"],
    "reason_codes": [
      "SCHEMA_INVALID",
      "TYPE_INVALID",
      "RANGE_INVALID",
      "IDENTITY_CONFLICT",
      "RECORDED_ENDPOINT_MISSING"
    ],
    "requires_independently_valid_delivery_identity": true,
    "invalid_value_storage": "PROHIBITED",
    "fact_or_metric_authority": false,
    "unassignable_rejection": "ADMISSION_OR_TRANSPORT_FAILURE_ONLY"
  },
  "retention": {
    "TASK_DECLARATION": "NEVER_EXPIRE",
    "DELIVERY_TASK_MEMBERSHIP": "NEVER_EXPIRE",
    "TASK_DISPLAY_NAME": "NEVER_EXPIRE",
    "DELIVERY_MANIFEST": "NEVER_EXPIRE",
    "dependent_fact_expiry_changes_membership": false,
    "logical_expiry": {
      "commit_scope": "DELIVERY",
      "tombstone": "NEVER_EXPIRE",
      "query_visibility": "ATOMIC"
    },
    "physical_scrub": {
      "scope": "BOUNDED_RECORDS",
      "public_state_effect": "NONE"
    }
  },
  "forbidden_inference": [
    "name-based identity or merge",
    "Workflow-based membership",
    "timestamp or arrival-order causality",
    "Trace closure as Task membership",
    "Fact or Trace reconstruction of a missing task.binding"
  ]
}
