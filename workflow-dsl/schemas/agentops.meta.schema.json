{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agentops:workflow-dsl:0.1.0:meta",
  "title": "Agent Ops Workflow DSL — shared definitions",
  "description": "Shared definitions referenced by every Agent Ops Workflow DSL document. Normative machine form of workflow-definition-dsl.md §5; structural admissibility only, semantic closure rules live in the spec.",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version MAJOR.MINOR.PATCH."
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^agentops\\.workflow-dsl@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$",
      "description": "Stable identity, unique within one Delivery/Snapshot."
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Exact immutable content identity."
    },
    "sourceLocator": {
      "type": "object",
      "required": ["repository", "path"],
      "properties": {
        "repository": { "type": "string" },
        "path": { "type": "string" },
        "ref": {
          "type": "string",
          "description": "Optional exact commit/tag. A floating alias (latest/bare name) is forbidden in a Snapshot binding."
        }
      },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "object",
      "required": ["path", "contentIdentity"],
      "properties": {
        "path": { "type": "string" },
        "contentIdentity": { "$ref": "#/$defs/contentIdentity" }
      },
      "additionalProperties": false
    },
    "inlineSchema": {
      "type": "object",
      "properties": {
        "type": { "enum": ["object", "array", "string", "integer", "number", "boolean", "null"] },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/inlineSchema" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "items": { "$ref": "#/$defs/inlineSchema" },
        "enum": { "type": "array" },
        "const": {}
      },
      "additionalProperties": false,
      "description": "Restricted inline JSON Schema. Complex schemas must be fixed references (schemaRef) resolved at Snapshot time."
    },
    "schemaOrInline": {
      "oneOf": [
        { "$ref": "#/$defs/schemaRef" },
        { "$ref": "#/$defs/inlineSchema" }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["field", "op"],
          "properties": {
            "field": {
              "type": "string",
              "description": "Dotted path into Workflow State, e.g. 'aggregation.routing'."
            },
            "op": {
              "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "exists", "notExists", "in", "notIn", "contains", "notContains"]
            },
            "value": {
              "description": "Required for eq/ne/gt/gte/lt/lte/in/notIn/contains/notContains; forbidden for exists/notExists."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["allOf"],
          "properties": { "allOf": { "type": "array", "items": { "$ref": "#/$defs/predicate" }, "minItems": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["anyOf"],
          "properties": { "anyOf": { "type": "array", "items": { "$ref": "#/$defs/predicate" }, "minItems": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/predicate" } },
          "additionalProperties": false
        }
      ],
      "description": "Closed predicate vocabulary over Workflow State. Compiles 1:1 to a conditional-edge function at the Implementation layer; no free-form code in the Definition."
    },
    "reducer": {
      "oneOf": [
        { "enum": ["overwrite", "append", "merge", "keepFirst", "sum", "max", "min"] },
        {
          "type": "object",
          "required": ["custom"],
          "properties": { "custom": { "$ref": "#/$defs/schemaRef" } },
          "additionalProperties": false,
          "description": "Custom reducer must reference a deterministic, content-addressed package-owned function; bound at the Implementation/compile layer."
        }
      ],
      "description": "State merge semantics. Built-in vocabulary is closed; see spec §5.3."
    },
    "resourceRef": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/identity" } },
      "additionalProperties": false,
      "description": "Reference to a resource declared in package.json resources.owned|referenced."
    },
    "identityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/identity" }
    },
    "authorityOrder": {
      "type": "array",
      "const": ["workflow_action", "role_prompt", "action_prompt", "skill", "artifact_user"],
      "description": "Canonical instruction authority order fixed by the Contract (spec §7). Any deviation fails admission."
    }
  }
}
