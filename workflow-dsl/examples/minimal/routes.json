{
  "kind": "agentops.routes",
  "schemaVersion": "agentops.workflow-dsl@1.1.0",
  "routes": [
    {
      "id": "route.facilitator.intake",
      "role": "role.facilitator",
      "agent": { "definition": { "id": "agent.definition.managed" }, "managedProjection": "required" },
      "resources": {
        "rolePrompt": { "id": "role.prompt.facilitator" },
        "actionPrompts": [{ "action": "action.intake", "prompt": { "id": "prompt.intake" } }],
        "skills": [{ "id": "skill.grilling" }],
        "model": { "id": "model.managed" },
        "tools": [{ "id": "tool.repo-read" }],
        "driver": { "id": "driver.managed-cli" },
        "capabilities": ["structured-completion", "action-interaction"],
        "sessionPolicy": { "scope": { "kind": "episode" }, "isolation": "shared" }
      },
      "access": [
        { "target": "repository", "mode": "read" },
        { "target": "ignored run-workspace", "mode": "write" }
      ],
      "escalationAllowed": false
    },
    {
      "id": "route.facilitator.aggregate",
      "role": "role.facilitator",
      "agent": { "definition": { "id": "agent.definition.managed" }, "managedProjection": "required" },
