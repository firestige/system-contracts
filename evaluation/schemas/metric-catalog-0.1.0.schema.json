{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/firestige/system-contracts/evaluation/schemas/metric-catalog-0.1.0.schema.json",
  "title": "Evaluation Metric Catalog 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "version", "status", "semantic_authority", "input_definitions", "metrics"],
  "properties": {
    "catalog_id": { "const": "agentops.evaluation.metric-catalog" },
    "version": { "const": "0.1.0" },
    "status": { "const": "REVIEW_CANDIDATE" },
    "semantic_authority": { "const": "workflow-self-recursive/docs/contracts/evaluation/metric-catalog.md@evaluation.identity.001" },
    "input_definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/inputDefinition" }
    },
    "metrics": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/definitions/metric" }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "uniqueStrings": {
      "type": "array",
      "items": { "$ref": "#/definitions/nonEmptyString" },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/nonEmptyString" },
      "uniqueItems": true
    },
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "source_layer", "semantic_ref", "binding"],
      "properties": {
        "input_id": { "type": "string", "pattern": "^(observation|evaluation|projection)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "source_layer": { "enum": ["observation", "evaluation", "projection"] },
        "semantic_ref": { "$ref": "#/definitions/nonEmptyString" },
        "binding": { "const": "human-semantic-reference" }
      }
    },
    "questionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "version"],
      "properties": {
        "question_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "valueSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unit", "missing"],
      "properties": {
        "kind": { "enum": ["rate", "count", "duration", "quantity", "money", "state"] },
        "unit": { "$ref": "#/definitions/nonEmptyString" },
        "missing": { "type": "string", "pattern": "^N/A when .+" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id", "version", "name", "status", "question_refs", "evaluation_unit",
        "value_semantics", "dimensions", "filters", "time_window", "calculation",
        "input_refs", "eligibility", "exclusions", "minimum_sample", "minimum_coverage",
        "uncertainty", "forbidden_inference", "owner"
      ],
      "properties": {
        "metric_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "status": { "enum": ["implemented", "planned"] },
        "question_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/questionRef" },
          "uniqueItems": true
        },
        "evaluation_unit": { "$ref": "#/definitions/nonEmptyString" },
        "value_semantics": { "$ref": "#/definitions/valueSemantics" },
        "dimensions": { "$ref": "#/definitions/uniqueStrings" },
        "filters": { "$ref": "#/definitions/uniqueStrings" },
        "time_window": { "$ref": "#/definitions/nonEmptyString" },
        "calculation": { "$ref": "#/definitions/nonEmptyString" },
        "input_refs": { "$ref": "#/definitions/nonEmptyUniqueStrings" },
        "eligibility": { "$ref": "#/definitions/nonEmptyUniqueStrings" },
        "exclusions": { "$ref": "#/definitions/uniqueStrings" },
        "minimum_sample": { "type": "integer", "minimum": 1 },
        "minimum_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty": { "$ref": "#/definitions/nonEmptyUniqueStrings" },
        "forbidden_inference": { "$ref": "#/definitions/nonEmptyUniqueStrings" },
        "owner": { "$ref": "#/definitions/nonEmptyString" }
      }
    }
  }
}
