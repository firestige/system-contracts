{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/firestige/system-contracts/evaluation/schemas/publication-record-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "contract_revision", "status", "published", "conformance_claim", "source_revision", "semantic", "artifacts", "gates"],
  "properties": {
    "record_version": { "const": "1.0.0" },
    "contract_revision": { "const": "agentops.evaluation.metric-catalog@1.0.0" },
    "status": { "const": "REVIEW_CANDIDATE" },
    "published": { "const": false },
    "conformance_claim": { "const": "NONE" },
    "source_revision": { "type": "string", "minLength": 1 },
    "semantic": { "$ref": "#/definitions/artifact" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/artifact" } },
    "gates": { "type": "object", "additionalProperties": false, "required": ["contract.gate.1", "contract.gate.2", "contract.gate.3", "contract.gate.4", "contract.gate.5", "contract.gate.6", "owner_approval"], "properties": { "contract.gate.1": { "type": "string" }, "contract.gate.2": { "type": "string" }, "contract.gate.3": { "type": "string" }, "contract.gate.4": { "type": "string" }, "contract.gate.5": { "type": "string" }, "contract.gate.6": { "type": "string" }, "owner_approval": { "type": "string" } } }
  },
  "definitions": { "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
}
