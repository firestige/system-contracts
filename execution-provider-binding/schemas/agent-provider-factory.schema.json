{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsr:execution:agent-provider-factory:1.0.0",
  "type": "object",
  "required": ["schemaVersion", "identity", "version", "adapterKey", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "execution.agent-provider-factory@1.0.0"},
    "identity": {"$ref": "#/$defs/identity"},
    "version": {"$ref": "#/$defs/version"},
    "adapterKey": {"enum": ["dsh-headless", "copilot-sdk", "codex-cli"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"}
  }
}
