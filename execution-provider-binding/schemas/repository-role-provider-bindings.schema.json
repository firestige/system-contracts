{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsr:execution:repository-role-provider-bindings:1.0.0",
  "type": "object",
  "required": ["schemaVersion", "bindings"],
  "properties": {
    "schemaVersion": {"const": "execution.repository-role-provider-bindings@1.0.0"},
    "bindings": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": {"$ref": "#/$defs/identity"},
      "additionalProperties": {"$ref": "#/$defs/binding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "binding": {
      "type": "object",
      "required": ["agentProvider", "model"],
      "properties": {
        "agentProvider": {"type": "object", "required": ["identity", "version"], "properties": {"identity": {"$ref": "#/$defs/identity"}, "version": {"$ref": "#/$defs/version"}}, "additionalProperties": false},
        "model": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"$ref": "#/$defs/identity"}, "model": {"$ref": "#/$defs/identity"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  }
}
