{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.agentops.dev/observation/compatibility-matrix-1.0.2.schema.json",
  "title": "Observation Exact Compatibility Matrix 1.0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_version", "status", "default", "semver_inference", "entries"],
  "properties": {
    "matrix_version": { "const": "1.0.2" },
    "status": { "const": "PUBLISHED" },
    "default": { "const": "FAIL_CLOSED" },
    "semver_inference": { "const": false },
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["producer_revision", "acceptor_revision", "profile_version", "family_schemas", "evidence"],
        "properties": {
          "producer_revision": { "enum": ["observation-contract@1.0.0", "observation-contract@1.0.1", "observation-contract@1.0.2"] },
          "acceptor_revision": { "const": "observation-contract@1.0.2" },
          "profile_version": { "const": "1.0.0" },
          "family_schemas": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["implementation@1", "system-design@1"] },
            "allOf": [
              { "contains": { "const": "implementation@1" } },
              { "contains": { "const": "system-design@1" } }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^fixtures/[A-Za-z0-9._/-]+\\.json$" }
          }
        }
      }
    }
  }
}
